<script type="text/javascript">
  var map;
  var homeMarkers = [];
  var selectedLocation = null;
  var facultyMarker = null;
  var openInfoWindow = null;
  var customInit = false;
  var mapInit = false;
 
  // Icon settings
  var iconScle = 0.15;
  var homeIcon = null;
  var facultyIcon = null;
  
